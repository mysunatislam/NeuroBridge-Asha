# Local-only defaults. Change credentials before exposing any service beyond localhost.
FINGERSPEAK_BIND_HOST=127.0.0.1
POSTGRES_DB=fingerspeak
POSTGRES_USER=fingerspeak
POSTGRES_PASSWORD=local-development-only
# Optional full override for managed databases or URL-encoded credentials. An empty value uses the
# Compose PostgreSQL defaults above. If you change any POSTGRES_* value, set this full URL to match;
# percent-encode reserved characters in the username or password.
FINGERSPEAK_DATABASE_URL=
FINGERSPEAK_ENVIRONMENT=development
FINGERSPEAK_CORS_ORIGINS=["http://localhost:3000"]
FINGERSPEAK_CORS_ALLOW_CREDENTIALS=true
FINGERSPEAK_TRUSTED_HOSTS=["localhost","127.0.0.1","api"]
FINGERSPEAK_ALLOW_DEVELOPMENT_IDENTITY=true
FINGERSPEAK_DEVELOPMENT_IDENTITY=local-user
# Required in staging/production; never expose this through NEXT_PUBLIC_* or other browser-public variables.
FINGERSPEAK_GATEWAY_HMAC_SECRET=
FINGERSPEAK_GATEWAY_SIGNATURE_TTL_SECONDS=60
FINGERSPEAK_WEBSOCKET_MAX_MESSAGE_BYTES=4096
FINGERSPEAK_DEVICE_ONLINE_TTL_SECONDS=30
FINGERSPEAK_DEVICE_CAPTION_TTL_SECONDS=120
FINGERSPEAK_LOG_LEVEL=INFO

# Optional server-only Asha provider configuration. With no key, Asha returns the bounded offline
# companion response. Never place this key in NEXT_PUBLIC_* or Raspberry Pi settings.
OPENAI_API_KEY=
FINGERSPEAK_OPENAI_MODEL=gpt-5.4-mini
FINGERSPEAK_OPENAI_VECTOR_STORE_ID=
FINGERSPEAK_OPENAI_TIMEOUT_SECONDS=12
FINGERSPEAK_OPENAI_MAX_OUTPUT_TOKENS=500

# Google Gemini AI provider (Free tier available at https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=
FINGERSPEAK_GEMINI_API_KEY=
FINGERSPEAK_GEMINI_MODEL=gemini-flash-latest
FINGERSPEAK_GEMINI_TIMEOUT_SECONDS=12
FINGERSPEAK_GEMINI_MAX_OUTPUT_TOKENS=500

# The only browser-public build setting. Direct Pi address/pairing is configured on the patient's
# device at runtime because hotspot addresses change; pairing credentials are never build variables.
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
