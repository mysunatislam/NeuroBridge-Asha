<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NeuroBridge Asha</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>NeuroBridge Asha</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>NeuroBridge Asha uses the camera for 3D hand landmark tracking and facial gesture communication.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>NeuroBridge Asha uses the microphone to record personalized caregiver phrases and assistive audio.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>NeuroBridge Asha uses speech recognition for assistive voice synthesis and companion interaction.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- iOS 14+ gates connections to LAN addresses behind the local-network
	     permission. The companion reaches the Raspberry Pi over ws://<lan-ip>,
	     so without this key that prompt has no explanation and the Pi link
	     cannot be established. Android needs no counterpart: INTERNET covers it. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>NeuroBridge Asha connects to the paired FingerSpeak wheelchair device on your local network to send confirmed captions to its display.</string>
	<!-- Counterpart of the Android manifest's <queries> DIAL/tel entry. The
	     patient, caregiver and emergency sheets all launch tel: URLs; declaring
	     the scheme keeps canLaunchUrl() honest on iOS. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
	</array>
	<key>io.flutter.embedded_views_preview</key>
	<true/>
</dict>
</plist>
